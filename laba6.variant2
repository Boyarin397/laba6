text = input("Введите строку: ")
longest_word = ""
current_word = ""
for char in text:
    if char != " ":
        current_word += char
    else:
        if len(current_word) > len(longest_word):
            longest_word = current_word
        current_word = ""
if len(current_word) > len(longest_word):
    longest_word = current_word
print("Самое длинное слово:", longest_word)
